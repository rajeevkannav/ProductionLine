{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductionLine (mogra) Configuration",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "factory": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "codename": { "type": "string" },
        "control_plane_repo": { "type": "string" }
      }
    },
    "human_in_the_loop": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "checkpoints": {
          "type": "object",
          "properties": {
            "discovery_approval": { "type": "boolean" },
            "spec_approval": { "type": "boolean" },
            "pr_review_required": { "type": "boolean" },
            "release_approval": { "type": "boolean" }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "harness": {
          "type": "string",
          "enum": ["antigravity", "gemini-cli", "claude-code", "codex", "goose", "openhands", "aider"]
        },
        "model": { "type": "string" },
        "sandbox": { "type": "string", "enum": ["worktree", "docker", "github-runner"] }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "harness": {
            "type": "string",
            "enum": ["antigravity", "gemini-cli", "claude-code", "codex", "goose", "openhands", "aider", "deterministic-ci"]
          },
          "model": { "type": "string" }
        }
      }
    },
    "outcome": {
      "type": "object",
      "properties": {
        "blueprint": { "type": "string" },
        "mode": {
          "type": "string",
          "enum": ["greenfield-stack", "incremental-feature"]
        },
        "stack": {
          "type": "string",
          "enum": [
            "react19-ts-vite",
            "vue3-ts-vite",
            "svelte5-ts-vite",
            "angular-ts",
            "solid-ts-vite",
            "rails8-pg-hotwire",
            "android-hotwire-native",
            "ios-hotwire-native"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "deployment": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "enum": ["github-pages", "render", "railway", "mobile-release", "none"]
        },
        "custom_domain": { "type": "string" },
        "render": {
          "type": "object",
          "properties": {
            "region": { "type": "string" },
            "health_path": { "type": "string" },
            "service_name": { "type": "string" }
          }
        },
        "railway": {
          "type": "object",
          "properties": {
            "health_path": { "type": "string" },
            "service_name": { "type": "string" }
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    }
  }
}
